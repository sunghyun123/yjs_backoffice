# 앱 실행
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8080
APP_DEMO_MODE=true
APP_TIMEZONE=Asia/Seoul

# Tailscale Serve를 통한 운영 접속에서만 true로 변경합니다.
APP_TRUST_TAILSCALE_HEADERS=false
APP_ALLOWED_TAILSCALE_USER=

# 씽크와이즈 MariaDB 읽기 전용 계정
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_CHARSET=utf8
DB_REFRESH_SECONDS=60
WORK_LOG_REFRESH_SECONDS=300

# 대시보드 자체 저장소
SQLITE_PATH=data/dashboard.db

# 메일 연동은 Phase 4에서 활성화합니다. 실제 값은 .env에만 저장합니다.
MAIL_REFRESH_SECONDS=300
