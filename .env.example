# 앱 실행
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8080
APP_DEMO_MODE=true
APP_TIMEZONE=Asia/Seoul

# 운영에서는 APP_ENV=production, APP_DEMO_MODE=false와 함께 반드시 true로 변경합니다.
APP_TRUST_TAILSCALE_HEADERS=false
APP_ALLOWED_TAILSCALE_USERS=

# 씽크와이즈 MariaDB 읽기 전용 계정
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_CHARSET=utf8
DB_REFRESH_SECONDS=60
WORK_LOG_REFRESH_SECONDS=60

# 위키가 생성하는 읽기 전용 작업 이력 색인. 설정하면 마지막 수정·최근 변경은
# 운영 DB 풀스캔 대신 이 파일에서 읽습니다.
# 두 저장소를 같은 상위 폴더에 배치한 운영 예시: ..\thinkwise-wiki\data\wiki_index.db
THINKWISE_INDEX_PATH=
THINKWISE_INDEX_MAX_AGE_SECONDS=180

# 대시보드 자체 저장소
SQLITE_PATH=data/dashboard.db

# 대표이사 개인 Google 계정의 이번 주 일정과 회사 공유 Drive 파일 메타데이터 읽기 전용 연동.
# Client ID/Secret은 Google Cloud의 Web application OAuth 클라이언트를 사용합니다.
# 운영 Redirect URI 예: https://your-private-dashboard.ts.net/api/google/oauth/callback
# 최초 승인 뒤 Refresh Token은 앱이 이 .env에만 저장합니다.
GOOGLE_ENABLED=false
GOOGLE_REFRESH_SECONDS=60
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_REDIRECT_URI=
# 회사 공유 드라이브 URL의 /drives/ 뒤에 표시되는 ID입니다. 비밀값은 아닙니다.
GOOGLE_SHARED_DRIVE_ID=

# 준비된 메일 계정만 활성화합니다. 실제 값은 .env에만 저장합니다.
MAIL_REFRESH_SECONDS=300
MAIL_DAOU_ENABLED=false
MAIL_DAOU_HOST=imap.daouoffice.com
MAIL_DAOU_PORT=993
MAIL_DAOU_USER=
MAIL_DAOU_PASSWORD=
# Example: https://your-company.daouoffice.com/
MAIL_DAOU_URL=
MAIL_GMAIL_ENABLED=false
MAIL_GMAIL_HOST=imap.gmail.com
MAIL_GMAIL_PORT=993
MAIL_GMAIL_USER=
MAIL_GMAIL_PASSWORD=
MAIL_GMAIL_URL=https://mail.google.com/
MAIL_NAVER_ENABLED=false
MAIL_NAVER_HOST=imap.naver.com
MAIL_NAVER_PORT=993
MAIL_NAVER_USER=
MAIL_NAVER_PASSWORD=
MAIL_NAVER_URL=https://mail.naver.com/
